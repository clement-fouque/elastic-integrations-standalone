# Host-side connections for OpenTofu and direct API requests.
ELASTICSEARCH_ENDPOINTS=https://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
KIBANA_ENDPOINT=https://localhost:5601

# Must match the externally started stack. No cluster services are defined here.
ELASTIC_VERSION=9.5.5
# The Agent shares the host network namespace.
ELASTIC_HOST=https://localhost:9200

# GitHub issues runtime-only settings. Never passed to OpenTofu.
GITHUB_ISSUES_OWNER=
GITHUB_ISSUES_REPOSITORY=
GITHUB_ISSUES_GITHUB_TOKEN=

# Optional GitHub Security Advisories PAT. Never passed to OpenTofu.
GITHUB_SECURITY_ADVISORIES_API_KEY=
# Required Slack incoming webhook for advisory detection rule alerts. Passed only to
# the github_security_advisories OpenTofu root as an ephemeral, write-only value.
TF_VAR_github_security_advisories_slack_webhook_url=

# Required Slack incoming webhook for CISA KEV detection rule alerts. Passed only to
# the cisa_kevs OpenTofu root as an ephemeral, write-only value.
TF_VAR_cisa_kevs_slack_webhook_url=
